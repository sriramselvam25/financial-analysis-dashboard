Revenue = SUM(FactFinancial[Revenue])
COGS = SUM(FactFinancial[COGS])
Gross Profit = [Revenue] - [COGS]
Gross Margin % = DIVIDE([Gross Profit],[Revenue])
Operating Expense = SUM(FactFinancial[OperatingExpense])
Operating Profit = [Gross Profit] - [Operating Expense]
Operating Margin % = DIVIDE([Operating Profit],[Revenue])
Budget Revenue = SUM(FactFinancial[BudgetRevenue])
Budget Variance = [Revenue] - [Budget Revenue]
Budget Variance % = DIVIDE([Budget Variance],[Budget Revenue])
Forecast Revenue = SUM(FactFinancial[ForecastRevenue])
Forecast Accuracy % = 1 - DIVIDE(ABS([Revenue]-[Forecast Revenue]),[Revenue])
Revenue PY = CALCULATE([Revenue], DATEADD(DimDate[Date],-1,YEAR))
YoY Growth % = DIVIDE([Revenue]-[Revenue PY],[Revenue PY])
